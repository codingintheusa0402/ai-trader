# AI Trader settings. Copy to .env (setup.sh does it) and keep .env private: it is in .gitignore.
# Everything here is optional for dry-run. With no broker keys the engine trades on paper using Yahoo prices.

# ── Broker ─────────────────────────────────────────────────────────────
# toss = 토스증권 Open API (tested with real money) | kis = 한국투자증권 (NOT tested, see trader/brokers/kis.py)
BROKER=toss

# 토스증권 Open API keys (토스증권 앱/웹 > Open API). Register this computer's IP in Toss's allowed-IP list.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT=

# 한국투자증권 KIS Open API (only when BROKER=kis)
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 8자리-상품코드 2자리, e.g. 12345678-01
KIS_ACCOUNT=
# paper = 모의투자 server (start here), real = 실전
KIS_ENV=paper

# ── Real money (OFF) ────────────────────────────────────────────────────
# Real orders need ALL of: REAL_TRADING_CONFIRMED=yes here, typing REAL MONEY in the app's 안전 tab,
# and a plan switched from dry-run to real. Leave this commented out until you have read README "실전 전환".
# REAL_TRADING_CONFIRMED=yes

# Hard caps, checked on every order no matter what the traders decide (USD for US stocks, KRW for KR).
# All traders together:
MAX_BUDGET_USD=200
MAX_BUDGET_KRW=200000
# One trader (plan):
MAX_PLAN_USD=200
MAX_PLAN_KRW=200000
# One order:
MAX_ORDER_USD=100
MAX_ORDER_KRW=100000
# Orders per 24 hours, all traders:
MAX_ORDERS_PER_DAY=40

# ── LLM (news scoring, nightly reflection, Live chat) ──────────────────
# Default: Claude Code CLI. Any CLI that reads stdin and prints an answer works. off = keyword-only, short chat replies.
# AITRADER_LLM_CMD=claude -p --model haiku
# AITRADER_LLM_CMD=codex exec -
# AITRADER_LLM_CMD=off

# What the traders call you in the Live chat (default 친구)
AITRADER_OWNER_NAME=친구

# ── Alerts (optional) ───────────────────────────────────────────────────
# Real-money trades, engine warnings and the 07:30 KST daily report are POSTed here as JSON {"text","content"}.
# Works with Slack, Discord, Google Chat and most chat webhooks. Empty = alerts only go to the log.
ALERT_WEBHOOK_URL=

# ── App ─────────────────────────────────────────────────────────────────
AITRADER_PORT=8764
# Phone access over a private VPN (e.g. your Tailscale 100.x address). Empty = this computer only.
AITRADER_MOBILE_HOST=
